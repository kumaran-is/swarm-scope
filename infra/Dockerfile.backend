FROM python:3.12-slim

WORKDIR /app

# Install uv
RUN pip install uv

# Copy dependency files
COPY pyproject.toml .

# Install dependencies
RUN uv pip install --system -e ".[dev]" || uv pip install --system fastapi uvicorn[standard] sqlalchemy[asyncio] asyncpg alembic pydantic-settings google-genai redis python-multipart pypdf python-docx python-jose[cryptography] passlib[bcrypt] numpy httpx

# Copy application code
COPY . .

# Create uploads directory
RUN mkdir -p /app/uploads

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
